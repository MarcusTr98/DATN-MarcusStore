
# CẤU HÌNH SERVER & ỨNG DỤNG
server.port=8080
spring.application.name=MarcusStore


# CẤU HÌNH KẾT NỐI SQL SERVER
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=MarcusStoreDB;encrypt=true;trustServerCertificate=true;
spring.datasource.username=sa
spring.datasource.password=${DB_PASSWORD:your_password_here}
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Cấu hình Pool kết nối (HikariCP) để tối ưu hiệu năng chịu tải
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=1200000

# CẤU HÌNH JPA / HIBERNATE
# 'validate' kiểm tra tính khớp nhau giữa Entity và DB
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.database-platform=org.hibernate.dialect.SQLServerDialect

# Hiển thị và định dạng câu lệnh SQL chạy ngầm
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.use_sql_comments=false
spring.jpa.open-in-view=false
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# CẤU HÌNH ĐỊNH DẠNG DỮ LIỆU JSON (JACKSON)
spring.jackson.time-zone=Asia/Ho_Chi_Minh
spring.jackson.date-format=yyyy-MM-dd HH:mm:ss

# CẤU HÌNH BẢO MẬT JWT (JSON WEB TOKEN)

# Chuỗi khóa bí mật dùng để ký token (Yêu cầu chuỗi Base64 ngẫu nhiên, dài, bảo mật)
marcusstore.app.jwtSecret=${JWT_SECRET:replace_with_a_base64_secret_of_at_least_64_characters}
# Thời gian sống của Access Token (Ví dụ: 86400000 ms = 24 giờ)
marcusstore.app.jwtExpirationMs=86400000

# CẤU HÌNH UPLOAD FILE (MULTIPART) - BỔ SUNG
# Giới hạn dung lượng tối đa cho 1 file (VD: 5MB để tối ưu băng thông)
spring.servlet.multipart.max-file-size=5MB
# Giới hạn dung lượng tối đa cho 1 request chứa nhiều file
spring.servlet.multipart.max-request-size=20MB

# CẤU HÌNH VNPAY SANDBOX
vnpay.tmnCode=${VNPAY_TMN_CODE:your_vnpay_tmn_code}
vnpay.hashSecret=${VNPAY_HASH_SECRET:your_vnpay_hash_secret}
vnpay.payUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay.returnUrl=http://localhost:5173/order-success
# Marcus thêm: VNPAY hết hạn 15 phút; chờ thêm 5 phút cho IPN đến chậm rồi mới tự hủy.
vnpay.paymentTimeoutMinutes=20
vnpay.expiryInitialDelayMs=60000
vnpay.expiryScanDelayMs=60000
# Marcus thêm endpoint Refund API của môi trường sandbox/dev VNPAY.
vnpay.refundUrl=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
vnpay.refundIpAddr=127.0.0.1
# Marcus thêm: chỉ môi trường sandbox mới được phép xác nhận refund thủ công.
vnpay.sandbox=true
# Marcus sửa: Sandbox dừng ở trạng thái chờ VNPAY, không xác nhận thành công giả trên giao diện.
vnpay.allowManualRefundConfirmation=false

# Marcus thêm: tự chuyển đơn DELIVERED thành COMPLETED nếu khách không tự xác nhận.
# Mặc định 72 giờ; scheduler không cho cấu hình thấp hơn 24 giờ để tránh đóng đơn nhầm.
order.auto-complete.delivered-after-hours=72
order.auto-complete.initial-delay-ms=60000
order.auto-complete.scan-delay-ms=1800000
# Marcus thêm: giới hạn đơn COD giữ kho và tự hủy COD chờ xác nhận quá lâu.
checkout.cod.max-pending-orders=3
checkout.cod.pending-timeout-hours=24
checkout.cod.expiry-initial-delay-ms=60000
checkout.cod.expiry-scan-delay-ms=300000

# CẤU HÌNH CLOUDINARY
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:your_cloud_name}
cloudinary.api-key=${CLOUDINARY_API_KEY:your_api_key}
cloudinary.api-secret=${CLOUDINARY_API_SECRET:your_api_secret}

# GIAO HANG NHANH (GHN) - MOI TRUONG TEST
ghn.api.token=${GHN_API_TOKEN:your_ghn_token}
ghn.api.shop-id=${GHN_SHOP_ID:your_ghn_shop_id}
ghn.api.url.fee=https://dev-online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/fee
ghn.api.url.create=https://dev-online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/create
ghn.store.district-id=1526
ghn.store.ward-code=20310

# Marcus sửa: token xác thực webhook GHN là bắt buộc, kể cả khi demo bằng
# Postman/ngrok. Request phải gửi cùng giá trị trong header X-Verification-Token.
ghn.webhook.token=${GHN_WEBHOOK_TOKEN:your_private_webhook_token}

# cấu hình đăng nhập đăng ký GG
google.oauth2.client-id=${GOOGLE_CLIENT_ID:your_google_client_id}
google.oauth2.client-secret=${GOOGLE_CLIENT_SECRET:your_google_client_secret}
spring.security.oauth2.client.registration.google.scope=email,profile
frontend.url=http://localhost:5173

# TRUNG TÂM SAO LƯU (chỉ ROLE_ADMIN)
# Thư mục phải là đường dẫn tuyệt đối, SQL Server service và backend đều có quyền đọc/ghi.
backup.storage-path=D:/MarcusStoreBackups
backup.sqlserver-directory=D:/MarcusStoreBackups
backup.retention.max-successful=10
backup.storage-warning-free-mb=1024
analytics.behavior.retention-days=365

# Marcus AI - Gemini Free Tier
gemini.api-key=${GEMINI_API_KEY:}
gemini.model=gemini-3.5-flash-lite
gemini.base-url=https://generativelanguage.googleapis.com

# Marcus thêm: profile dùng khi demo/bảo vệ, giảm log nội bộ nhưng giữ nguyên
# application.properties cho môi trường phát triển của cả nhóm.
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
logging.level.org.springframework.security=WARN
logging.level.org.springframework.security.web.authentication=WARN
