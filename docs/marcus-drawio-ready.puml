' Draw.io-ready PlantUML: copy ONE @startuml...@enduml block per import.
' diagrams.net: Arrange > Insert > Advanced > PlantUML.
' Standard style: A4-friendly, Arial, short labels, high contrast.

' ============================================================
' UC-04 - USE CASE
' ============================================================
@startuml UC04_USECASE
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam dpi 160
skinparam shadowing false
skinparam ArrowColor #1F4E79
skinparam activityBorderColor #1F4E79
skinparam activityBackgroundColor #F7FBFF
skinparam activityDiamondBorderColor #1F4E79
skinparam activityDiamondBackgroundColor #EAF3F8
skinparam partitionBorderColor #5B9BD5
skinparam partitionBackgroundColor #FFFFFF
skinparam actorBorderColor #1F4E79
skinparam actorFontColor #1F1F1F
skinparam usecaseBorderColor #1F4E79
skinparam usecaseBackgroundColor #F7FBFF
skinparam usecaseFontColor #1F1F1F
skinparam rectangleBorderColor #1F4E79
skinparam rectangleBackgroundColor #FFFFFF
skinparam nodesep 35
skinparam ranksep 35
title UC-04: Quản lý sổ địa chỉ và bản đồ động
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase { BackgroundColor White; BorderColor #1F4E79; ArrowColor #1F4E79 }
actor "Khách hàng" as Customer
rectangle "Hệ thống MarcusStore" {
  usecase "Xem danh sách\nđịa chỉ" as U04_View
  usecase "Thêm địa chỉ" as U04_Add
  usecase "Cập nhật địa chỉ" as U04_Update
  usecase "Xóa địa chỉ" as U04_Delete
  usecase "Đặt địa chỉ\nmặc định" as U04_Default
  usecase "Chọn địa giới\nGHN" as U04_GHN
  usecase "Chọn vị trí\ntrên bản đồ" as U04_Map
}
Customer --> U04_View
Customer --> U04_Add
Customer --> U04_Update
Customer --> U04_Delete
Customer --> U04_Default
Customer --> U04_Map
U04_Add ..> U04_GHN : <<include>>
U04_Update ..> U04_GHN : <<include>>
U04_Map ..> U04_Add : <<extend>>
U04_Map ..> U04_Update : <<extend>>
note bottom of U04_Map: Tọa độ bản đồ là tùy chọn
note bottom of U04_Delete: Không được xóa địa chỉ mặc định
@enduml

