|GHN|
start
:Gửi Webhook trạng thái vận đơn;
|Hệ thống|
:Xác thực Verification Token;
if (Token hợp lệ?) then (Có)
  :Chuẩn hóa trạng thái GHN;
  |Dữ liệu|
  :Khóa đơn theo Tracking Code;
  |Hệ thống|
  if (Trạng thái được hỗ trợ\nvà chuyển đổi hợp lệ?) then (Có)
    |Dữ liệu|
    :Cập nhật đơn và lịch sử trạng thái;
    :Xử lý tài chính hoặc hủy nếu cần;
    |Hệ thống|
    :Gửi thông báo cho khách hàng;
    :Cảnh báo Admin nếu thất bại hoặc hủy;
  else (Không)
    :Bỏ qua trạng thái không hợp lệ;
  endif
else (Không)
  :Từ chối Webhook;
endif
|GHN|
:Nhận phản hồi;
stop
@enduml
